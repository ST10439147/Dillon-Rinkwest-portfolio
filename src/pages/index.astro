---
type Project = {
  name: string;
  kind: string;
  problem: string;
  stack: string[];
  repo?: string;
  demo?: string;
  image?: string;
  lesson?: string; // "What I'd do differently". Shown only when set.
};

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const yt = (id: string) => ({ demo: `https://youtu.be/${id}`, image: `https://img.youtube.com/vi/${id}/hqdefault.jpg` });
const email = 'dillonrinkwest@outlook.com';
const cv = `${base}DillonRinkwest-CV.pdf`;
// Link previews need absolute URLs; Astro.site comes from the deploy workflow (undefined locally).
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const pageUrl = abs(base);
const ogImage = abs(`${base}og.png`);
// GoatCounter site code (the "xyz" in xyz.goatcounter.com). Empty = analytics off.
const goatcounter = 'dillonrinkwest';
const title = 'Dillon Rinkwest | Backend and Cloud Engineer';
const description = 'Software engineer building C#, .NET and Azure systems: REST APIs, Blazor apps, Docker and CI/CD. Projects, experience and CV.';

// Order = what you want to be hired for first.
const projects: Project[] = [
  {
    name: 'Azure Retail Platform',
    kind: 'Cloud',
    problem: 'Retail management with role-based access, backed by Azure SQL and Table, Blob and Queue Storage, with CRUD exposed through Azure Functions.',
    stack: ['ASP.NET Core 8', 'Azure Functions', 'Azure Storage', 'Azure SQL'],
    repo: 'https://github.com/ST10439147/Cloud-Azure-Functions-App',
    ...yt('P-oUV2yOKHA'),
  },
  {
    name: 'The Lucky Budget',
    kind: 'Android · AI · Team lead',
    problem: 'Personal finance app for expenses, bank accounts, savings goals and subscriptions. Gemini 2.5 Flash turns the last 30 days of spending into budget advice, with custom Canvas charts, PDF export, live currency conversion and Firebase sign-in. I led a team of three.',
    stack: ['Kotlin', 'MVVM', 'Firebase', 'Gemini API', 'GitHub Actions'],
    repo: 'https://github.com/ST10439147/LuckyBudget',
    ...yt('pipU8XDkbBA'),
  },
  {
    name: 'Global Logistics Management System',
    kind: 'Fullstack',
    problem: 'Logistics platform for clients, contracts and service requests. A Blazor Server frontend calls a separate REST API with JWT role-based access and SignalR notifications, runs as three Docker Compose services, and is tested and built on every push by GitHub Actions.',
    stack: ['ASP.NET Core 10', 'Blazor Server', 'SignalR', 'Docker', 'GitHub Actions'],
    repo: 'https://github.com/ST10439147/GLMS',
  },
  {
    name: 'Vaultlet',
    kind: 'Security',
    problem: 'Local-first, zero-knowledge password manager: Argon2id key derivation, AES-256-GCM vaults, end-to-end encrypted sync with three-way merge, TOTP, breach checks and a browser extension.',
    stack: ['Python', 'Argon2id', 'AES-GCM', 'JavaScript'],
    repo: 'https://github.com/ST10439147/Vaultlet',
    image: `${base}cards/vaultlet.svg`,
  },
  {
    name: 'IoT Mesh Gateway (Smart-X)',
    kind: 'Backend · IoT',
    problem: 'Minimal API ingesting telemetry from a simulated 13-node ESP32 mesh, with a Blazor WebAssembly console. AVL trees for time-range queries, BFS, Prim and Dijkstra for routing, and rerouting around failed nodes.',
    stack: ['ASP.NET Core 10', 'Blazor WASM', 'Algorithms', 'Docker'],
    repo: 'https://github.com/ST10439147/SmartX-IoT-mesh-simulator',
    image: `${base}cards/smartx.svg`,
  },
  {
    name: 'Contract Monthly Claim System',
    kind: 'Backend',
    problem: 'Two-stage claim approval across four user roles, with AES-256 encrypted document storage and a full audit trail.',
    stack: ['ASP.NET Core', 'EF Core', 'SQL Server', 'xUnit'],
    repo: 'https://github.com/ST10439147/CMCS_Platform',
    ...yt('mzmmVi46Yd4'),
  },
  {
    name: 'NPO Management Platform',
    kind: 'Team · Private',
    problem: 'Fixing day-to-day operational problems for a non-profit, built with a student team. I lead the platform and backend work.',
    stack: ['.NET 10 Web API', 'Blazor', '.NET MAUI', 'Azure SQL', 'Key Vault'],
    image: `${base}cards/npo.svg`,
  },
  {
    name: 'HustleHub',
    kind: 'Web',
    problem: 'Connects freelancers with clients.',
    stack: ['JavaScript'],
    repo: 'https://github.com/ST10439147/HustleHub',
    image: `${base}cards/hustlehub.svg`,
  },
];

const skills = [
  { title: 'Backend', icon: 'ri-server-line', items: ['ASP.NET Core MVC', 'Web API', 'EF Core', 'ADO.NET', 'xUnit', 'JWT auth'] },
  { title: 'Cloud', icon: 'ri-cloud-line', items: ['Azure Functions', 'Azure SQL', 'Table / Blob / Queue Storage', 'Key Vault', 'Web Apps', 'Firebase', 'Docker'] },
  { title: 'Data', icon: 'ri-database-2-line', items: ['Microsoft SQL Server', 'Azure SQL', 'MySQL', 'Oracle (SQL Developer)', 'MongoDB', 'Room (SQLite)', 'Firebase Firestore', 'Relational data modelling'] },
  { title: 'Frontend', icon: 'ri-layout-line', items: ['Blazor', '.NET MAUI', 'WPF', 'Bootstrap 5', 'HTML / CSS'] },
  { title: 'Languages', icon: 'ri-code-s-slash-line', items: ['C#', 'Java', 'Kotlin', 'Python', 'TypeScript', 'JavaScript', 'SQL', 'Bash'] },
  { title: 'Tools & DevOps', icon: 'ri-git-branch-line', items: ['Git', 'GitHub Actions CI/CD', 'Docker / Compose', 'Linux', 'SonarQube Cloud', 'Grafana','Visual Studio', 'Android Studio'] },
  { title: 'Practices', icon: 'ri-compasses-2-line', items: ['Systems design', 'REST API design', 'Object-oriented design', 'Design patterns', 'JWT & role-based access', 'Unit testing', 'Code review'] },
];

const experience = [
  { when: 'April 2026 — now', title: 'Lead Engineer, NPO Management Platform', where: 'Student team · non-profit client', text: 'Building a management platform now being delivered to the client: .NET 10 Web API, EF Core and Azure (SQL, Key Vault, Blob Storage, Communication Services), with Blazor and .NET MAUI clients.' },
  { when: 'April 2026 — November 2026', title: 'Tutor, School of Computer Science', where: 'Emeris Newlands (Varsity College)', text: 'Weekly consultations, debugging sessions and code reviews for first- and second-year students, explaining the root cause of each fix rather than handing over the answer.' },
  { when: '2026', title: 'Golden Key · IITPSA · Cisco', where: 'Honours & certifications', text: 'Golden Key International Honour Society (top 15%, 85.75% average), IITPSA student member, and Cisco Introduction to Cybersecurity.' },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03080c" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dillon Rinkwest, Backend and Cloud Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Unbounded:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" />
    {goatcounter && (
      <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <header class="header">
      <div class="blob-animate"></div>
      <nav class="nav container">
        <a href="#home" class="logo">Dillon Rinkwest</a>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#contact">Contact</a></li>
          <li><a href={cv} download data-goatcounter-click="cv-download">CV</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section id="home" class="home container">
        <p class="greeting">Hello, I'm</p>
        <h1 class="name">Dillon<br />Rinkwest</h1>

        <div class="portrait">
          <div class="blob-animate big"></div>
          <img src={`${base}profile.jpg`} alt="Dillon Rinkwest" width="320" height="320" />
          <div class="social">
            <a href="https://github.com/ST10439147" aria-label="GitHub"><i class="ri-github-line"></i></a>
            <a href="https://www.linkedin.com/in/dillon-rinkwest-1005702a0" aria-label="LinkedIn"><i class="ri-linkedin-box-line"></i></a>
            <a href={`mailto:${email}`} data-goatcounter-click="email-click" aria-label="Email"><i class="ri-mail-line"></i></a>
          </div>
          <a href={cv} download data-goatcounter-click="cv-download" class="cv-side">Resume <i class="ri-download-line"></i></a>
        </div>

        <p class="role">
          <span class="rotator" aria-label="Backend, Cloud and Fullstack">
            <span>Cloud</span><span>Fullstack</span><span>Backend</span>
          </span>
          <span class="split">Engineer</span>
        </p>
      </section>

      <section id="about" class="about container">
        <h2 class="title">Building is <span>my craft</span></h2>
        <p class="about-text">
          I'm a software engineer in the final year of a <b>Computer and Information Sciences</b> degree at Emeris Newlands, Cape Town.
          I build fullstack systems in <b>C# / .NET</b> on SQL Server and <b>Azure</b>: REST APIs, relational data models,
          Docker containers and <b>GitHub Actions</b> pipelines with automated tests. I'm just as at home in <b>Java</b>:
          object-oriented applications with Swing user interfaces, unit tested with JUnit,
          and Android apps in <b>Kotlin</b> on the same JVM foundations. I lead the engineering on a student team's
          production system for a non-profit, and I tutor for the School of Computer Science.
        </p>
        <div class="contact-actions">
          <a href="#projects" class="button">See my work <i class="ri-arrow-right-up-line"></i></a>
          <a href={cv} download data-goatcounter-click="cv-download" class="button ghost">Download CV <i class="ri-download-line"></i></a>
        </div>
      </section>

      <section id="projects" class="projects container">
        <h2 class="title left">I build <span>real projects</span></h2>
        <div class="cards">
          {projects.map((p, i) => (
            <article class="card">
              <div class="blob"></div>
              <div class="card-top">
                <span class="num">{pad(i + 1)}</span>
                <span class="kind">{p.kind}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="stack-label">Tech stack</p>
              <p class="stack">{p.stack.join(', ')}</p>
              <p class="desc">{p.problem}</p>
              {p.lesson && <p class="desc"><b>What I'd do differently:</b> {p.lesson}</p>}
              {p.image && (
                <div class="shot">
                  <img src={p.image} alt="" loading="lazy" />
                  {(p.demo ?? p.repo) && (
                    <a href={p.demo ?? p.repo} class="shot-link" aria-label={`Open ${p.name}`}><i class="ri-arrow-right-up-line"></i></a>
                  )}
                </div>
              )}
              <div class="card-links">
                {p.demo && <a href={p.demo}><i class="ri-play-circle-line"></i> Demo</a>}
                {p.repo && <a href={p.repo}><i class="ri-github-line"></i> Code</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="skills container">
        <h2 class="title">What I <span>work with</span></h2>
        <div class="skill-grid">
          {skills.map((s, i) => (
            <details class="skill" open={i === 0}>
              <summary>
                <i class={s.icon}></i>
                <span>{s.title}</span>
                <i class="ri-arrow-down-s-line chevron"></i>
              </summary>
              <ul>{s.items.map((it) => <li><i class="ri-star-line"></i>{it}</li>)}</ul>
            </details>
          ))}
        </div>
      </section>

      <section class="work container">
        <h2 class="title">Experience <span>so far</span></h2>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <span class="when">{e.when}</span>
              <h3>{e.title}</h3>
              <p class="where">{e.where}</p>
              <p>{e.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="contact" class="contact container">
        <div class="blob"></div>
        <h2 class="title">Let's <span>work together</span></h2>
        <p class="contact-text">Available now for full-time software engineering roles: backend, fullstack and cloud.</p>
        <p class="email" id="email">{email}</p>
        <div class="contact-actions">
          <button class="button" id="copy" type="button">Copy email <i class="ri-file-copy-line"></i></button>
          <a class="button ghost" href={`mailto:${email}`} data-goatcounter-click="email-click">Send email <i class="ri-send-plane-line"></i></a>
        </div>
        <div class="contact-links">
          <a href="https://github.com/ST10439147"><i class="ri-github-line"></i> GitHub</a>
          <a href="https://www.linkedin.com/in/dillon-rinkwest-1005702a0"><i class="ri-linkedin-box-line"></i> LinkedIn</a>
        </div>
      </section>
    </main>

    <footer class="footer container">© {new Date().getFullYear()} Dillon Rinkwest · Built with Astro, deployed by GitHub Actions</footer>

    <script is:inline>
      document.getElementById('copy').addEventListener('click', (e) => {
        const btn = e.currentTarget;
        navigator.clipboard.writeText(document.getElementById('email').textContent).then(() => {
          btn.innerHTML = 'Copied <i class="ri-check-line"></i>';
          setTimeout(() => (btn.innerHTML = 'Copy email <i class="ri-file-copy-line"></i>'), 2000);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Change this one number to re-colour the site: 168 teal, 200 sky, 30 amber, 340 rose, 255 purple. */
    --hue: 168;
    --first: hsl(var(--hue), 65%, 55%);
    --first-alt: hsl(var(--hue), 80%, 42%);
    --first-light: hsl(var(--hue), 60%, 72%);
    --title: hsl(200, 10%, 95%);
    --text: hsl(200, 8%, 70%);
    --text-light: hsl(200, 8%, 50%);
    --body: hsl(210, 60%, 3%);
    --container: hsl(210, 20%, 7%);
    --body-font: 'Montserrat', system-ui, sans-serif;
    --title-font: 'Unbounded', system-ui, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { background: var(--body); color: var(--text); font: 0.98rem/1.6 var(--body-font); overflow-x: hidden; }
  h1, h2, h3, .logo { font-family: var(--title-font); color: var(--title); font-weight: 500; }
  a { color: inherit; text-decoration: none; }
  ul, ol { list-style: none; }
  img { max-width: 100%; display: block; }
  .container { max-width: 1120px; margin-inline: auto; padding-inline: 16px; }
  section { padding-block: 5rem 1rem; position: relative; }
  .title { font-size: clamp(1.5rem, 4vw, 2.25rem); text-align: center; margin-bottom: 3rem; }
  .title span { color: var(--first); }
  .title.left { text-align: left; }

  /* Glowing blobs */
  .blob-animate {
    position: absolute; width: 100px; height: 100px; border-radius: 50%; z-index: -1;
    background: linear-gradient(180deg, var(--first-alt) 20%, var(--first-light) 100%);
    filter: blur(35px); animation: spin 5s linear infinite;
  }
  .blob {
    position: absolute; width: 250px; height: 250px; border-radius: 50%; z-index: 0; pointer-events: none;
    background: linear-gradient(180deg, var(--first) 0%, var(--first-alt) 100%); filter: blur(60px); opacity: 0.55;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Header */
  .header { position: fixed; inset: 0 0 auto; z-index: 100; background: linear-gradient(180deg, var(--body) 60%, transparent); }
  .header .blob-animate { top: -3rem; left: -3rem; }
  .nav { display: flex; justify-content: space-between; align-items: center; padding-block: 1.1rem; }
  .logo { font-size: 1rem; }
  .nav ul { display: flex; gap: 1.75rem; }
  .nav ul a { font-family: var(--title-font); font-size: 0.85rem; color: var(--title); transition: color 0.3s; }
  .nav ul a:hover { color: var(--first); }
  @media (max-width: 560px) { .logo { display: none; } .nav { justify-content: flex-end; } .nav ul { gap: 1.1rem; } }

  /* Home */
  .home { padding-top: 7rem; text-align: center; display: grid; justify-items: center; }
  .greeting { color: var(--first); font-family: var(--title-font); font-size: 1.2rem; }
  .name { font-size: clamp(2.2rem, 7vw, 3.6rem); line-height: 1.1; margin-bottom: 2rem; }
  .portrait { position: relative; width: min(320px, 78vw); aspect-ratio: 1; }
  .portrait .big { width: 260px; height: 260px; inset: 0; margin: auto; filter: blur(50px); }
  .portrait img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; border-radius: 50%;
    border: 4px solid var(--first); box-shadow: 0 0 60px hsla(var(--hue), 65%, 55%, 0.45);
  }
  .social { position: absolute; left: -3.5rem; top: 50%; transform: translateY(-50%); display: grid; gap: 0.9rem; }
  .social a { color: var(--title); font-size: 1.35rem; transition: transform 0.3s, color 0.3s; }
  .social a:hover { color: var(--first); transform: translateX(4px); }
  .cv-side {
    position: absolute; right: -4.5rem; top: 50%; rotate: -90deg; display: flex; align-items: center; gap: 0.5rem;
    font: 500 0.85rem var(--title-font); color: var(--text-light); transition: color 0.3s;
  }
  .cv-side:hover { color: var(--first); }
  @media (max-width: 560px) { .cv-side { display: none; } }
  @media (max-width: 560px) { .social { position: static; transform: none; display: flex; justify-content: center; margin-top: 1.25rem; gap: 1.5rem; } }

  .role { margin-top: 2rem; font-family: var(--title-font); font-size: clamp(1.4rem, 4vw, 2rem); color: var(--title); display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5ch; align-items: baseline; }
  .rotator { display: inline-grid; justify-items: end; height: 1.3em; overflow: hidden; color: var(--first); }
  .rotator span { grid-area: 1 / 1; animation: roll 9s ease-in-out infinite; transform: translateY(110%); }
  .rotator span:nth-child(2) { animation-delay: 3s; }
  .rotator span:nth-child(3) { animation-delay: 6s; }
  @keyframes roll {
    0% { transform: translateY(110%); } 4%, 33% { transform: translateY(0); } 37%, 100% { transform: translateY(-110%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rotator span, .blob-animate { animation: none; }
    .rotator span { transform: none; } .rotator span:not(:last-child) { display: none; }
  }

  /* Buttons */
  .button {
    display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
    padding: 0.95rem 2rem; border-radius: 4rem; border: 3px solid var(--first);
    background: var(--body); color: var(--title); font: 600 0.9rem var(--title-font);
    box-shadow: 0 8px 32px hsla(var(--hue), 65%, 55%, 0.45), inset 8px -8px 30px var(--first-alt);
    transition: box-shadow 0.3s;
  }
  .button:hover { box-shadow: 0 8px 48px hsla(var(--hue), 65%, 55%, 0.7), inset 8px -8px 30px var(--first-alt); }
  .button.ghost { box-shadow: none; }
  .button.ghost:hover { box-shadow: 0 8px 32px hsla(var(--hue), 65%, 55%, 0.45); }

  /* About */
  .about { text-align: center; }
  .about-text { max-width: 640px; margin: 0 auto 2.5rem; font-size: 1.05rem; }
  .about-text b { color: var(--title); font-weight: 600; }

  /* Projects */
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1.5rem; }
  .card { position: relative; overflow: hidden; background: var(--container); border-radius: 2.5rem; padding: 1.75rem; display: flex; flex-direction: column; isolation: isolate; }
  .card .blob { right: -8rem; bottom: -4rem; z-index: -1; opacity: 0.35; transition: opacity 0.4s; }
  .card:hover .blob { opacity: 0.6; }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .num { font: 500 2.2rem var(--title-font); color: var(--title); }
  .kind { font-size: 0.9rem; color: var(--title); }
  .card h3 { font-size: 1.15rem; margin-bottom: 1rem; }
  .stack-label { font: 0.75rem var(--title-font); color: var(--title); }
  .stack { font-size: 0.85rem; color: var(--first-light); margin-bottom: 0.75rem; }
  .desc { font-size: 0.88rem; margin-bottom: 1rem; }
  .shot { position: relative; margin-top: auto; }
  .shot img { border-radius: 1.25rem; aspect-ratio: 16 / 9; object-fit: contain; background: #1a1b27; width: 100%; }
  .shot-link {
    position: absolute; top: 0.75rem; right: 0.75rem; width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; border: 3px solid var(--first); background: var(--body); color: var(--title); font-size: 1.4rem;
    opacity: 0; transition: opacity 0.3s, box-shadow 0.3s;
  }
  .shot:hover .shot-link, .shot-link:focus-visible { opacity: 1; }
  .shot-link:hover { box-shadow: 0 0 24px var(--first); }
  .card-links { display: flex; gap: 1.25rem; margin-top: 1rem; font-family: var(--title-font); font-size: 0.8rem; color: var(--title); }
  .card-links a:hover { color: var(--first); }

  /* Skills: native <details> accordion */
  .skill-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1.25rem; align-items: start; }
  .skill { background: var(--container); border-radius: 1.5rem; padding: 1.25rem 1.5rem; border: 1px solid transparent; transition: border-color 0.3s; }
  .skill[open] { border-color: hsla(var(--hue), 65%, 55%, 0.4); }
  .skill summary { display: flex; align-items: center; gap: 0.75rem; cursor: pointer; list-style: none; font: 500 1rem var(--title-font); color: var(--title); }
  .skill summary::-webkit-details-marker { display: none; }
  .skill summary > i:first-child { color: var(--first); font-size: 1.4rem; }
  .chevron { margin-left: auto; transition: transform 0.3s; }
  .skill[open] .chevron { transform: rotate(180deg); }
  .skill ul { margin-top: 1rem; display: grid; gap: 0.4rem; font-size: 0.9rem; }
  .skill li i { color: var(--first); margin-right: 0.5rem; }

  /* Experience */
  .timeline { max-width: 720px; margin-inline: auto; border-left: 2px solid hsla(var(--hue), 65%, 55%, 0.35); }
  .timeline li { position: relative; padding: 0 0 2.25rem 2rem; }
